---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<header class="site-header">
  <!-- 右上のハンバーガーボタン -->
  <button id="menu-toggle" class="hamburger-btn" aria-label="メニューを開く">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <!-- 中央のタイトルエリア -->
  <div class="header-main">
    <h1 class="site-title"><a href="/">{SITE_TITLE}</a></h1>
    <p class="site-desc">{SITE_DESCRIPTION}</p>
  </div>

  <!-- ブルーのナビゲーション帯 -->
  <nav class="sub-bar">
    <a href="/">ホーム</a>
    <a href="/blog">記事一覧</a>
  </nav>

  <!-- タップで開くドロワーメニュー -->
  <div id="drawer-menu" class="drawer-menu">
    <div class="drawer-header">
      <span>メニュー</span>
      <button id="menu-close" class="close-btn">&times;</button>
    </div>
    <ul>
      <li><a href="/">ホーム</a></li>
      <li><a href="/blog">すべての記事</a></li>
      <li><a href="/about">このブログについて</a></li>
    </ul>
  </div>
  <div id="menu-overlay" class="menu-overlay"></div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const drawer = document.getElementById('drawer-menu');
  const overlay = document.getElementById('menu-overlay');

  function openMenu() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
  }
  function closeMenu() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
</script>

<style>
  .site-header {
    background-color: #f9fafb;
    position: relative;
    border-bottom: 1px solid #e5e7eb;
  }
  .header-main {
    text-align: center;
    padding: 36px 16px 24px;
  }
  .site-title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
  }
  .site-title a {
    text-decoration: none;
    color: #222;
  }
  .site-desc {
    margin: 8px 0 0;
    font-size: 0.85rem;
    color: #666;
  }
  .sub-bar {
    background-color: #5b89b8;
    display: flex;
    justify-content: space-around;
    padding: 10px 0;
  }
  .sub-bar a {
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* ハンバーガーボタン */
  .hamburger-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    z-index: 10;
  }
  .hamburger-btn span {
    display: block;
    width: 20px;
    height: 2px;
    background-color: #333;
  }

  /* ドロワーメニュー */
  .drawer-menu {
    position: fixed;
    top: 0;
    right: -260px;
    width: 250px;
    height: 100vh;
    background: #fff;
    box-shadow: -2px 0 8px rgba(0,0,0,0.15);
    transition: right 0.25s ease;
    z-index: 100;
    padding: 16px;
  }
  .drawer-menu.open {
    right: 0;
  }
  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
    font-weight: bold;
  }
  .close-btn {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }
  .drawer-menu ul {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }
  .drawer-menu li {
    border-bottom: 1px solid #f0f0f0;
  }
  .drawer-menu li a {
    display: block;
    padding: 12px 4px;
    text-decoration: none;
    color: #333;
    font-size: 0.95rem;
  }
  .menu-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 90;
  }
  .menu-overlay.open {
    display: block;
  }
</style>
